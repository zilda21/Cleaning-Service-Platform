@page
@model IndexModel
@{
    ViewData["Title"] = "Hjem";
}


<!-- HERO SECTION -->
<section class="hero-section py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="display-5 fw-bold">
                    Professionel rengøring til hjem og erhverv
                </h1>
                <p class="lead mt-3">
                    Hos THS Pleje tilbyder vi privat og erhvervsrengøring
                    med fokus på kvalitet, tillid og service.
                </p>
                <a class="btn btn-primary btn-lg mt-3" href="#">
                    Book rengøring
                </a>
            </div>

            <div class="col-md-6">
                <!-- image later -->
            </div>
        </div>
    </div>
</section>

<!-- SERVICES -->
<section id="services" class="py-5 bg-light">
    <div class="container text-center">
        <h2 class="fw-bold mb-4">Vores services</h2>

        <div class="row">
            <div class="col-md-4">
                <h5>Regelmæssig rengøring</h5>
                <p>Ugentlig eller månedlig rengøring for et rent hjem.</p>
            </div>

            <div class="col-md-4">
                <h5>Hovedrengøring</h5>
                <p>Grundig rengøring af køkken, bad og opholdsrum.</p>
            </div>

            <div class="col-md-4">
                <h5>Ind- & udflytningsrengøring</h5>
                <p>Perfekt før indflytning eller efter fraflytning.</p>
            </div>
        </div>
    </div>
</section>

<!-- WHY US -->
<section class="py-5">
    <div class="container">
        <h2 class="fw-bold mb-4">Hvorfor vælge os?</h2>

        <ul class="list-unstyled">
            <li>✔ Professionelt og pålideligt personale</li>
            <li>✔ Nem online booking</li>
            <li>✔ Fleksible tider</li>
            <li>✔ Gennemsigtige priser</li>
        </ul>
    </div>
</section>

<!-- REVIEWS -->
<section id="reviews" class="py-5 bg-light">
    <div class="container text-center">
        <h2 class="fw-bold mb-4">Hvad siger vores kunder?</h2>

        <div class="row">
            <div class="col-md-4">
                ⭐⭐⭐⭐⭐
                <p>“Meget professionel service og nem booking.”</p>
                <strong>— Sarah M.</strong>
            </div>

            <div class="col-md-4">
                ⭐⭐⭐⭐⭐
                <p>“Kom til tiden og gjorde et fantastisk stykke arbejde.”</p>
                <strong>— Ahmed K.</strong>
            </div>

            <div class="col-md-4">
                ⭐⭐⭐⭐☆
                <p>“God service – jeg booker igen.”</p>
                <strong>— Lina P.</strong>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="py-5 text-center">
    <div class="container">
        <h2 class="fw-bold">Klar til et rent og friskt hjem?</h2>
        <a class="btn btn-primary btn-lg mt-3" href="#">
            Book en rengøring nu
        </a>
    </div>
</section>
