<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <title>@(ViewData["Title"] ?? "THS Pleje & Rengøring")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

<div class="bg-light border-bottom py-2">
    <div class="container d-flex justify-content-between small">
        <div>📧 info@ths-pleje.dk | 📞 +45 30 11 77 62</div>
        <div>
            <a href="#">Facebook</a>
            <a href="#">Instagram</a>
        </div>
    </div>
</div>

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold" asp-page="/Index">THS Pleje & Rengøring</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" asp-page="/Index">Hjem</a></li>
                <li class="nav-item"><a class="nav-link" href="#services">Services</a></li>
                <li class="nav-item"><a class="nav-link" href="#reviews">Anmeldelser</a></li>
                <li class="nav-item">
                    <a class="btn btn-primary ms-2" asp-page="/Login">Book nu</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main>
    @RenderBody()
</main>

<footer class="bg-dark text-white text-center py-4 mt-5">
    © 2025 THS Pleje & Rengøring
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
