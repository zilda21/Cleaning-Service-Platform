@page
@model CleaningService.Web.Pages.SignupModel
@{
    ViewData["Title"] = "Sign Up";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">

            <h2 class="text-center mb-4">Sign Up</h2>

            <form method="post">

                <div class="mb-3">
                    <label asp-for="NewUser.Name" class="form-label"></label>
                    <input asp-for="NewUser.Name" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="NewUser.Email" class="form-label"></label>
                    <input asp-for="NewUser.Email" class="form-control"required />
                </div>

                <div class="mb-3">
                    <label asp-for="NewUser.Password" class="form-label"></label>
                    <input asp-for="NewUser.Password" type="password" class="form-control " required />
                </div>

              
                <button type="submit" class="btn btn-primary w-100">
                    Sign Up
                </button>

            </form>

            <div class="text-center mt-3">
                <a asp-page="/Login">Already have an account?</a>
            </div>

        </div>
    </div>
</div>
