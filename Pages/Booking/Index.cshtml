@page
@model CleaningService.Web.Pages.Booking.IndexModel
@{
    ViewData["Title"] = "Booking";
}

<h2>Booking</h2>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMsg))
{
    <div class="alert alert-danger">@Model.ErrorMsg</div>
}

<h4>Create booking</h4>

<form method="post" class="mb-4">
    <div class="row g-3">
        @foreach (var p in Model.BookingProps)
        {
            if (string.Equals(p.Name, "Id", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            <div class="col-md-6">
                <label class="form-label">@p.Name</label>

                @{
                    var t = p.PropertyType;
                    var inputType = "text";

                    if (t == typeof(int) || t == typeof(long) || t == typeof(decimal) || t == typeof(double) || t == typeof(float)
                        || t == typeof(int?) || t == typeof(long?) || t == typeof(decimal?) || t == typeof(double?) || t == typeof(float?))
                        inputType = "number";
                    else if (t == typeof(DateTime) || t == typeof(DateTime?))
                        inputType = "datetime-local";
                    else if (t == typeof(bool) || t == typeof(bool?))
                        inputType = "checkbox";
                }

                @if (inputType == "checkbox")
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="@p.Name" />
                    </div>
                }
                else
                {
                    <input class="form-control" type="@inputType" name="@p.Name" />
                }
            </div>
        }
    </div>

    <button class="btn btn-primary mt-3" type="submit">Create</button>
</form>

<h4>All bookings</h4>

<table class="table table-striped">
    <thead>
        <tr>
            @foreach (var p in Model.BookingProps)
            {
                <th>@p.Name</th>
            }
        </tr>
    </thead>
    <tbody>
    @foreach (var b in Model.Bookings)
    {
        <tr>
            @foreach (var p in Model.BookingProps)
            {
                <td>@(p.GetValue(b) ?? "")</td>
            }
        </tr>
    }
    </tbody>
</table>