@page
@model CleaningService.Web.Pages.SignupModel
@{
    ViewData["Title"] = "Sign Up";
    ViewData["BodyClass"] = "starter-page";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center min-vh-100">
        <div class="col-lg-4 col-md-6 auth-card">

            <h2 class="text-center mb-4 auth-title">Opret konto</h2>

            <form method="post">

                <div class="mb-3">
                    <label  class="form-label"></label>
                    <input  class="form-control" placeholder="Fuldt navn" required />
                </div>

                <div class="mb-3">
                    <label  class="form-label"></label>
                    <input  class="form-control" placeholder="din@email.dk" required />
                </div>

                <div class="mb-3">
                    <label  class="form-label"></label>
                    <input  type="password" class="form-control" placeholder="Vælg et password" required />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">
                    Sign Up
                </button>

            </form>

            <div class="text-center mt-3 auth-link">
                <a asp-page="/login">Har du allerede en konto?</a>
            </div>

        </div>
    </div>
</div>
