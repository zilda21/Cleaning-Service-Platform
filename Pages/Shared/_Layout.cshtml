@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <title>@(ViewData["Title"] ?? "THS Pleje & Rengøring")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicons (CoreBiz template assets) -->
    <link href="~/assets/img/favicon.png" rel="icon">
    <link href="~/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <!-- Fonts (CoreBiz) -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Open+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500;1,600;1,700;1,800&family=Montserrat:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <!-- Vendor CSS Files -->
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

    <!-- Main CSS File -->
    <link href="~/assets/css/main.css" rel="stylesheet">

    <!-- App overrides -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
@{
    var bodyClass = (ViewData["BodyClass"] as string) ?? "starter-page";
}
<body class="@bodyClass">

<header id="header" class="header sticky-top">

    <!-- Top Bar -->
    <div class="topbar d-flex align-items-center dark-background">
        <div class="container d-flex justify-content-center justify-content-md-between">
            <div class="contact-info d-flex align-items-center">
                <i class="bi bi-envelope d-flex align-items-center"><a href="mailto:info@ths-pleje.dk">info@ths-pleje.dk</a></i>
                <i class="bi bi-phone d-flex align-items-center ms-4"><span>+45 30 11 77 62</span></i>
            </div>
            <div class="social-links d-none d-md-flex align-items-center">
                <a href="#" class="facebook" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                <a href="#" class="instagram" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
            </div>
        </div>
    </div>

    <!-- Branding + Nav -->
    <div class="branding d-flex align-items-center">
        <div class="container position-relative d-flex align-items-center justify-content-between">
            <a asp-page="/Index" class="logo d-flex align-items-center">
                <h1 class="sitename">THS Pleje &amp; Rengøring</h1>
            </a>

            <nav id="navmenu" class="navmenu">
             <ul>
    <li><a asp-page="/Index" class="@(ViewData["Title"]?.ToString() == "Hjem" ? "active" : "")">Hjem</a></li>
    <li><a href="/#services">Services</a></li>
    <li><a href="/#reviews">Anmeldelser</a></li>

    @if (Context.Session.GetString("Role") == "Admin")
    {
        <li><a asp-page="/Booking/Index">Booking Dashboard</a></li>
        <li><a asp-page="/Admin/Index">Admin Dashboard</a></li>
        <li><a asp-page="/Admin/Logs/Index">Logs Dashboard</a></li>
    }
    else
    {
        <li><a asp-page="/login" class="nav-cta">Book nu</a></li>
    }
</ul>
                <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
            </nav>
        </div>
    </div>

</header>

<main class="main">
    @RenderBody()
</main>

<footer id="footer" class="footer dark-background">
    <div class="container">
        <div class="row gy-4">
            <div class="col-lg-6">
                <h4 class="sitename">THS Pleje &amp; Rengøring</h4>
                <p class="mb-1">Professionel rengøring til hjem og erhverv.</p>
                <p class="mb-0">📍 Danmark • 📧 info@ths-pleje.dk • 📞 +45 30 11 77 62</p>
            </div>
            <div class="col-lg-6 text-lg-end">
                <div class="social-links d-flex justify-content-lg-end gap-3">
                    <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                </div>
            </div>
        </div>

        <div class="container copyright text-center mt-4">
            <p>© <span>@DateTime.Now.Year</span> <strong class="px-1 sitename">THS Pleje &amp; Rengøring</strong> <span>All Rights Reserved</span></p>
        </div>
    </div>
</footer>

<!-- Scroll Top -->
<a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

<!-- Preloader -->
<div id="preloader">
    <div></div>
    <div></div>
    <div></div>
    <div></div>
</div>

<!-- Vendor JS Files -->
<script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/assets/vendor/php-email-form/validate.js"></script>
<script src="~/assets/vendor/aos/aos.js"></script>
<script src="~/assets/vendor/glightbox/js/glightbox.min.js"></script>
<script src="~/assets/vendor/purecounter/purecounter_vanilla.js"></script>
<script src="~/assets/vendor/waypoints/noframework.waypoints.js"></script>
<script src="~/assets/vendor/swiper/swiper-bundle.min.js"></script>
<script src="~/assets/vendor/imagesloaded/imagesloaded.pkgd.min.js"></script>
<script src="~/assets/vendor/isotope-layout/isotope.pkgd.min.js"></script>

<!-- Main JS File -->
<script src="~/assets/js/main.js"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
