@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
    ViewData["BodyClass"] = "starter-page";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center min-vh-100">
        <div class="col-lg-4 col-md-6 auth-card">

            <h2 class="text-center mb-4 auth-title">Login</h2>

            <form method="post">

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input name="sEmail" class="form-control" placeholder="din@email.dk" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input name="sPassword" type="password" class="form-control" placeholder="••••••••" />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">
                    Login
                </button>
            </form>

            <div class="text-center mt-3 auth-link">
                <a asp-page="/signup">Du har ikke en konto?</a>
            </div>

        </div>
    </div>
</div>
